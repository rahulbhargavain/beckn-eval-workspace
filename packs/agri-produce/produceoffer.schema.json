{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "unitCode"
  ],
  "properties": {
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "unitCode": {
      "enum": [
        "KGM",
        "TNE",
        "C62",
        "LTR"
      ]
    },
    "minOrderQuantity": {
      "type": "integer",
      "minimum": 1
    },
    "deliveryLeadDays": {
      "type": "integer",
      "minimum": 0
    }
  }
}
