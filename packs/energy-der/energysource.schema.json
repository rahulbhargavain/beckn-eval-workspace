{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "sourceType",
    "capacityKw",
    "meterId"
  ],
  "properties": {
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "sourceType": {
      "enum": [
        "solar",
        "wind",
        "battery",
        "hydro",
        "biomass",
        "grid"
      ]
    },
    "capacityKw": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "meterId": {
      "type": "string",
      "minLength": 1
    }
  }
}
