{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "unitCode"
  ],
  "properties": {
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "unitCode": {
      "enum": [
        "C62",
        "DAY",
        "HUR"
      ]
    },
    "cancellationPolicy": {
      "type": "string"
    }
  }
}
