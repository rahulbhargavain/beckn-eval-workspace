{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.beckn-eval.invalid/schemas/Produce/v0.1/schema.json",
  "title": "Produce",
  "description": "Compliance and freshness facts for agricultural produce. Name, grade and description belong in the Descriptor. originType, certificationScope and the assay figures (moisturePercent, brixDegrees) let a buyer tell own-land produce from lawful collection, domestic from export-valid certification, and dry from damp lots; their allowed values are network policy.",
  "type": "object",
  "required": [
    "@context",
    "@type"
  ],
  "properties": {
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "originCountry": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "harvestDate": {
      "type": "string",
      "format": "date"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "originType": {
      "type": "string",
      "minLength": 1
    },
    "gradingStandard": {
      "type": "string",
      "minLength": 1
    },
    "certificationScheme": {
      "type": "string",
      "minLength": 1
    },
    "certificationScope": {
      "type": "string",
      "minLength": 1
    },
    "moisturePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "brixDegrees": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
