{
  "id": "NEG-006",
  "name": "DS: replay-new-body is rejected",
  "level": "mandatory",
  "roles": [
    "DS"
  ],
  "spec": "beckn-2.0.0 (protocol-specifications-v2 @ a22300a)",
  "notes": "Same messageId, different transactionId, fresh signature: only a messageId-keyed cache rejects it (docs/Authentication_and_Trust.md 10.1).",
  "request": {
    "method": "POST",
    "path": "/discover",
    "body": "fixtures/search.json",
    "auth": "beckn-http-signature",
    "fault": "replay-new-body"
  },
  "expect": {
    "status": 400,
    "jsonpath": {
      "$.message.status": "NACK",
      "$.message.error.code": {
        "type": "string",
        "enum": [
          "CTX_MESSAGE_ID_DUPLICATE",
          "AUT_REPLAY_DETECTED"
        ]
      },
      "$.message.error.message": {
        "type": "string",
        "pattern": "."
      },
      "$.message.messageId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "headers": {
      "Signature": {
        "pattern": "keyId=\"[^\"]+\",algorithm=\"ed25519\""
      }
    },
    "response_signature": {
      "chain": true
    }
  }
}
